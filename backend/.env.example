# Server environment: development | production
PARAMETRICAD_ENVIRONMENT=development

# Parameter extraction backend: auto | rule_based | groq
PARAMETRICAD_EXTRACTOR=auto

# Optional: Groq API key for LLM-based parameter extraction
# When omitted, the service falls back to the deterministic rule-based extractor
PARAMETRICAD_GROQ_API_KEY=

# Maximum concurrent CAD kernel executions
PARAMETRICAD_KERNEL_MAX_CONCURRENCY=1

# Mesh quality validation gate
PARAMETRICAD_REJECT_INVALID_MESHES=true
